@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-head">
    <h1 class="page-title">Error</h1>
</div>

<div class="panel confirm-panel">
    <p class="mb-2">Ocurrió un error al procesar la solicitud.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small">Código de solicitud: <code>@Model.RequestId</code></p>
    }
    <div class="form-actions">
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</div>
