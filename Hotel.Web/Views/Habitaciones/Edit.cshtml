@model Habitacion
@{
    ViewData["Title"] = "Editar habitación";
}

<div class="page-head">
    <h1 class="page-title">Editar habitación</h1>
</div>

<form asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="panel form-panel">
    <input type="hidden" asp-for="IdHabitacion" />
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
